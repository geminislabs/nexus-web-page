{
	"name": "tracker-monitor-app",
	"private": true,
	"version": "1.25.1",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo '' && husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"lint:fix": "prettier --write . && eslint . --fix",
		"test": "vitest run",
		"test:unit": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"validate": "npm run lint && npm run check && npm run test:coverage && npm run build",
		"commitlint": "commitlint",
		"audit": "npm audit --audit-level=high",
		"scan:secrets": "bash scripts/gitleaks-scan.sh",
		"scan:osv": "bash scripts/osv-scan.sh",
		"icons": "node scripts/iconos.mjs"
	},
	"lint-staged": {
		"*.{js,svelte}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,css,md,html}": [
			"prettier --write"
		]
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@eslint/js": "^10.0.1",
		"@iconify-json/mdi": "^1.2.3",
		"@playwright/test": "^1.64.0",
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@tailwindcss/postcss": "^4.3.3",
		"@types/node": "^26.6.5",
		"@vitest/coverage-v8": "^5.0.3",
		"autoprefixer": "^10.6.1",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"happy-dom": "^21.0.4",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"postcss": "^8.5.29",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^3.3.3",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"vite": "^7.3.7",
		"vitest": "^5.0.2"
	},
	"dependencies": {
		"@fontsource/ibm-plex-sans": "^5.3.0",
		"@fontsource/sora": "^5.3.0",
		"@googlemaps/js-api-loader": "^2.1.3",
		"@googlemaps/markerclusterer": "^2.6.2",
		"@iconify/svelte": "^5.2.2",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/context-async-hooks": "^2.11.0",
		"@opentelemetry/exporter-logs-otlp-http": "^0.223.0",
		"@opentelemetry/exporter-metrics-otlp-http": "^0.223.0",
		"@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
		"@opentelemetry/instrumentation-fetch": "^0.223.0",
		"@opentelemetry/instrumentation-http": "^0.223.0",
		"@opentelemetry/resources": "^2.11.0",
		"@opentelemetry/sdk-logs": "^0.223.0",
		"@opentelemetry/sdk-metrics": "^2.11.0",
		"@opentelemetry/sdk-trace-node": "^2.11.0",
		"@opentelemetry/sdk-trace-web": "^2.11.0",
		"@opentelemetry/semantic-conventions": "^1.43.0",
		"@turf/turf": "^7.4.0",
		"chart.js": "^4.5.1",
		"h3-js": "^4.5.0"
	},
	"overrides": {
		"cookie": "^0.7.0",
		"esbuild": ">=0.28.1",
		"js-yaml": ">=5.4.1",
		"fast-uri": ">=4.1.5",
		"tar": ">=7.5.19",
		"brace-expansion": ">=5.0.12",
		"minimatch@9": "10.2.6",
		"nanoid": ">=3.3.17",
		"devalue": ">=5.9.2"
	}
}
