# API Configuration
VITE_API_BASE_URL=http://localhost:8100/api/v1

# Comunicaciones GPS — REST y WebSocket de posiciones (siscom-api :8000)
VITE_COMM_API_URL=http://localhost:8000

# Admin API (si difiere de VITE_API_BASE_URL)
VITE_ADMIN_API_URL=http://localhost:8100/api/v1

# Sitio corporativo (auth centralizado, /legal/*). En local: geminis-labs-web-page.
# Si queda vacío, los enlaces legales usan https://www.geminislabs.com
VITE_COMPANY_URL=http://localhost:5174

# Google Maps API Key
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Runtime (adapter-node en producción — no es variable Vite)
# ORIGIN=https://nexus.example.com
# PORT=3340
